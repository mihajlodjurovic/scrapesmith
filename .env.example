# Copy to .env and fill in the key. .env is gitignored.
# Any OpenAI-compatible provider works; the base URL and model are free-form.
SCRAPESMITH_API_KEY=
SCRAPESMITH_PROVIDER=openai
SCRAPESMITH_BASE_URL=https://api.openai.com/v1
SCRAPESMITH_MODEL=gpt-4.1-mini

# Examples:
# OpenRouter:  https://openrouter.ai/api/v1        anthropic/claude-sonnet-4
# Groq:        https://api.groq.com/openai/v1      llama-3.3-70b-versatile
# Together:    https://api.together.xyz/v1         meta-llama/Llama-3.3-70B-Instruct-Turbo
# Ollama:      http://127.0.0.1:11434/v1           qwen2.5-coder:14b   (no key needed)

# Extra headers for gateways that require routing or version headers (JSON).
# SCRAPESMITH_LLM_HEADERS={"X-Custom-Header":"value"}

# Pipeline knobs
SCRAPESMITH_MAX_REPAIRS=2
SCRAPESMITH_SANDBOX_TIMEOUT=180
SCRAPESMITH_SANDBOX_MAX_PAGES=1

# Local testing only: allow probing private/loopback hosts
SCRAPESMITH_ALLOW_PRIVATE=0

# Politeness mode: polite respects robots.txt, unrestricted ignores it.
SCRAPESMITH_MODE=polite

# Thinking models: low keeps tokens for code instead of reasoning
SCRAPESMITH_REASONING_EFFORT=low

# Headless-browser fallback for JavaScript-rendered sites: auto | always | off.
# Needs: pip install -r requirements-browser.txt && python -m playwright install chromium
SCRAPESMITH_BROWSER=auto
